  "scenes": [
    {
      "id": "scene_1",
      "label": "الموقع الأثري الضخم",
      "narration": "في قلب السهول التونسية بقرية الجم الصغيرة، بتقف آثار أكبر كوليزيه في شمال إفريقيا. ده مش مجرد معلم عادي، ده مبنى ضخم بيكشف عظمة العمارة الرومانية في إفريقيا وبيعكس التاريخ القديم للمنطقة بشكل مباشر ودقيق.",
      "labels": [
        "الجم الصغيرة",
        "شمال إفريقيا"
      ],
      "visual_mode": "hero",
      "evidence_excerpt_id": 8,
      "evidence_quote": "Indicators Amphitheatre of El Jem The impressive ruins of the largest colosseum in North Africa,",
      "start": 0,
      "end": 17.92
    },
    {
      "id": "scene_2",
      "label": "طريقة البناء الفريدة",
      "narration": "المبنى ده مبني بالكامل من كتل حجرية ضخمة، وغريب إنه من غير أساسات وكمان حر بذاته. الهندسة دي بتخليه تحفة معمارية نادرة قدرت تقاوم الزمن وتثبت كفاءة البنائين الرومان في إقامة منشآت عملاقة على أرض منسطحة.",
      "labels": [
        "كتل حجرية",
        "من غير أساسات"
      ],
      "visual_mode": "material",
      "evidence_excerpt_id": 37,
      "evidence_quote": "amphitheatre is built entirely of stone blocks, with no foundations and free-standing. In this respect",
      "start": 17.92,
      "end": 35.76
    },
    {
      "id": "scene_3",
      "label": "السعة الاستيعابية الهائلة",
      "narration": "علشان نعرف حجم المبنى ده، لازم نتخيل إنه كان بيقدر يستوعب لحد خمسة وثلاثين ألف متفرج جوه ساحته. الرقم ده بيوضح إزاي كانت المدينة القديمة بتستضيف تجمعات شعبية ضخمة وعروض جماعية بتعكس قوة الإمبراطورية.",
      "labels": [
        "خمسة وثلاثين ألف متفرج",
        "ساحته"
      ],
      "visual_mode": "levels",
      "evidence_excerpt_id": 9,
      "evidence_quote": "a huge amphitheatre which could hold up to 35,000 spectators, are found in the small",
      "start": 35.76,
      "end": 52.84
    },
    {
      "id": "scene_4",
      "label": "تصميم الواجهات والعقود",
      "narration": "واجهة المدرّج بتتكون من تلات مستويات كاملة من العقود الفخمة اللي بتأتي على الطراز الكورنثي أو المركب. التفاصيل المعمارية دي مش شكل جمالي وبس، دي بتدعم الهيكل وبتوزع الأحمال بطريقة هندسية مدروسة ودقيقة للغاية.",
      "labels": [
        "تلات مستويات",
