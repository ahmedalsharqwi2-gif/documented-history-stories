  "caption_groups": [
    {
      "text": "في قلب السهول التونسية بقرية الجم",
      "start": 0,
      "end": 2.78
    },
    {
      "text": "الصغيرة، بتقف آثار أكبر كوليزيه في",
      "start": 2.78,
      "end": 6.04
    },
    {
      "text": "شمال إفريقيا. ده مش مجرد معلم",
      "start": 6.04,
      "end": 8.46
    },
    {
      "text": "عادي، ده مبنى ضخم بيكشف عظمة",
      "start": 8.46,
      "end": 11.42
    },
    {
      "text": "العمارة الرومانية في إفريقيا وبيعكس التاريخ",
      "start": 11.42,
      "end": 14.44
    },
    {
      "text": "القديم للمنطقة بشكل مباشر ودقيق. المبنى",
      "start": 14.44,
      "end": 18.44
    },
    {
      "text": "ده مبني بالكامل من كتل حجرية",
      "start": 18.44,
      "end": 20.42
    },
    {
      "text": "ضخمة، وغريب إنه من غير أساسات",
      "start": 20.48,
      "end": 23.02
    },
    {
      "text": "وكمان حر بذاته. الهندسة دي بتخليه",
      "start": 23.02,
      "end": 26.62
    },
    {
      "text": "تحفة معمارية نادرة قدرت تقاوم الزمن",
      "start": 27.02,
      "end": 29.76
    },
    {
      "text": "وتثبت كفاءة البنائين الرومان في إقامة",
      "start": 29.76,
      "end": 32.76
    },
    {
      "text": "منشآت عملاقة على أرض منسطحة. علشان",
      "start": 32.76,
      "end": 36.08
    },
    {
      "text": "نعرف حجم المبنى ده، لازم نتخيل",
      "start": 36.08,
      "end": 38.42
    },
    {
      "text": "إنه كان بيقدر يستوعب لحد خمسة",
      "start": 38.42,
      "end": 40.86
    },
    {
      "text": "وثلاثين ألف متفرج جوه ساحته. الرقم",
      "start": 40.86,
      "end": 44.26
    },
    {
      "text": "ده بيوضح إزاي كانت المدينة القديمة",
      "start": 44.26,
      "end": 46.74
    },
    {
      "text": "بتستضيف تجمعات شعبية ضخمة وعروض جماعية",
      "start": 46.74,
      "end": 49.76
    },
    {
      "text": "بتعكس قوة الإمبراطورية. واجهة المدرّج بتتكون",
      "start": 49.76,
      "end": 53.98
    },
    {
      "text": "من تلات مستويات كاملة من العقود",
      "start": 53.98,
      "end": 55.96
    },
    {
      "text": "الفخمة اللي بتأتي على الطراز الكورنثي",
      "start": 55.96,
      "end": 58.86
    },
    {
      "text": "أو المركب. التفاصيل المعمارية دي مش",
      "start": 58.86,
      "end": 61.8
    },
    {
      "text": "شكل جمالي وبس، دي بتدعم الهيكل",
      "start": 61.8,
      "end": 64.16
    },
    {
      "text": "وبتوزع الأحمال بطريقة هندسية مدروسة ودقيقة",
      "start": 64.34,
      "end": 67.62
    },
    {
      "text": "للغاية. من جوه، المبنى حافظ على",
      "start": 68.12,
      "end": 71.14
    },
    {
      "text": "معظم البنية التحتية الأساسية اللي كانت",
      "start": 71.14,
      "end": 73.58
    },
    {
      "text": "مسؤولة عن دعم المدرجات والمراتب. جدار",
      "start": 73.58,
      "end": 75.88
    },
    {
      "text": "المنصة والساحة والممرات السفلية لسه بحالة",
      "start": 76.88,
      "end": 80.0
    },
    {
      "text": "سليمة تقريباً، وده بيدينا صورة حية",
      "start": 80.0,
      "end": 82.94
    },
    {
      "text": "عن ترتيبات العروض القديمة. إنشاء المبنى",
      "start": 82.94,
      "end": 85.7
    },
    {
      "text": "ده في إقليم بعيد وبتصميم معقد",
      "start": 85.7,
      "end": 88.02000000000001
    },
    {
      "text": "مخصص للفرجة الشعبية بيعتبر نموذج حقيقي",
      "start": 88.22,
      "end": 92.14
    },
    {
      "text": "للدعاية الإمبراطورية الرومانية. ده غير إنه",
      "start": 92.14,
      "end": 95.58
    },
    {
      "text": "بيشهد على الازدهار الاقتصادي والتجاري الكبير",
      "start": 95.58,
      "end": 98.34
    },
    {
      "text": "اللي وصلت له مدينة ثيسدروس القديمة.",
      "start": 98.34,
      "end": 100.68
    },
    {
      "text": "عشان نحافظ على التراث ده، عمليات",
      "start": 101.28,
      "end": 103.82
    },
    {
      "text": "الترميم اللي اتعملت على مدار السنين",
      "start": 103.82,
      "end": 105.86
    },
    {
      "text": "محافظتش على جوهر المبنى الهيكلي. القوانين",
      "start": 106.4,
      "end": 109.32
    },
    {
      "text": "واللوائح الحديثة بتحدد ارتفاعات المباني المجاورة",
      "start": 109.76,
      "end": 111.44
    },
    {
      "text": "عشان تحمي المنظور البصري والمحيط الأثري",
      "start": 112.58,
      "end": 115.42
    },
    {
      "text": "للمدرّج من الزحف العمراني. في النهاية،",
      "start": 115.42,
      "end": 119.58
    },
    {
      "text": "مدرّج الجم بيمثل شاهد فريد على",
      "start": 119.58,
      "end": 122.58
    },
    {
      "text": "العمارة المخصصة للفعاليات الجماهيرية في إفريقيا",
      "start": 122.58,
      "end": 125.96
    },
    {
      "text": "الرومانية. الحفاظ على المكونات المعمارية دي",
      "start": 125.96,
      "end": 129.96
    },
    {
      "text": "بيضمن بقاء واحد من أعظم الرموز",
      "start": 129.96,
      "end": 132.2
    },
    {
      "text": "التاريخية للعالم القديم حياً قدام الأجيال.",
      "start": 132.2,
      "end": 135.88
    }
  ],
