  "caption_groups": [
    {
      "text": "في شمال شرق مقاطعة ويلز، وتحديداً",
      "start": 0,
      "end": 3.3
    },
    {
      "text": "في أجواء الثورة الصناعية، ظهر إنجاز",
      "start": 3.3,
      "end": 6.08
    },
    {
      "text": "هندسي ضخم بيمتد لمسافة ثمانية عشر",
      "start": 6.08,
      "end": 8.4
    },
    {
      "text": "كيلومتراً. المشروع ده بيعكس تحدي كبير",
      "start": 8.9,
      "end": 12.18
    },
    {
      "text": "للبيئة الجغرافية الوعرة اللي اختاروها عشان",
      "start": 12.2,
      "end": 15.04
    },
    {
      "text": "تمر منها المية من غير أي",
      "start": 15.04,
      "end": 16.58
    },
    {
      "text": "كوابح تقليدية تعطل حركة النقل المائي.",
      "start": 16.58,
      "end": 20.0
    },
    {
      "text": "المهندس المدني الشهير توماس تيلفورد هو",
      "start": 20.52,
      "end": 23.56
    },
    {
      "text": "اللي وضع التصميم الأساسي للعمل ده.",
      "start": 23.56,
      "end": 25.88
    },
    {
      "text": "الرؤية الهندسية اعتمدت على إيجاد حلول",
      "start": 25.88,
      "end": 28.78
    },
    {
      "text": "جريئة وغير معتادة لتجاوز المرتفعات والوديان،",
      "start": 28.78,
      "end": 32.86
    },
    {
      "text": "وهو الأمر اللي تطلب تفكير مختلف",
      "start": 32.86,
      "end": 34.98
    },
    {
      "text": "تماماً عن الطرق القديمة اللي كانت",
      "start": 34.98,
      "end": 37.4
    },
    {
      "text": "بتعتمد على الإنشاءات الحجرية الضخمة لوحدها.",
      "start": 37.4,
      "end": 39.28
    },
    {
      "text": "السر الأساسي في نجاح التصميم ده",
      "start": 40.44,
      "end": 42.58
    },
    {
      "text": "كان استخدام المعدن المسبوك والحديد المزخرف",
      "start": 42.58,
      "end": 45.3
    },
    {
      "text": "في هيكل القناة. المادتين دول سمحوا",
      "start": 45.3,
      "end": 48.12
    },
    {
      "text": "بإنشاء قناطر بتتسم بالخفة والصلابة في",
      "start": 48.12,
      "end": 50.96
    },
    {
      "text": "نفس الوقت، وده أدى لشكل نهائي",
      "start": 50.96,
      "end": 53.42
    },
    {
      "text": "بيجمع بين الضخامة والرشاقة الهندسية الواضحة",
      "start": 53.42,
      "end": 56.6
    },
    {
      "text": "لكل عابر. من أبرز الخصائص التشغيلية",
      "start": 56.6,
      "end": 59.32
    },
    {
      "text": "للقناة إنها اتبلت وبُنيت من غير",
      "start": 59.4,
      "end": 62.42
    },
    {
      "text": "استخدام أي كوابح نهائياً على طول",
      "start": 62.42,
      "end": 64.18
    },
    {
      "text": "مسارها. ده تطلب دقة بالسنتيمتر في",
      "start": 65.14,
      "end": 67.48
    },
    {
      "text": "توزيع المية ووزنها داخل المجرى المصنوع",
      "start": 67.48,
      "end": 69.82
    },
    {
      "text": "من الحديد، عشان يفضل التدفق مستمر",
      "start": 69.82,
      "end": 72.42
    },
    {
      "text": "ومنتظم من غير ما يشكل ضغط",
      "start": 72.42,
      "end": 74.9
    },
    {
      "text": "مدمر على الجوانب. العمل اعتمد على",
      "start": 75.04,
      "end": 77.78
    },
    {
      "text": "تجميع أجزاء معدنية متكررة بدقة متناهية",
      "start": 77.78,
      "end": 81.02
    },
    {
      "text": "فوق دعامات حجرية مرتفعة ورقيقة. التناغم",
      "start": 81.02,
      "end": 84.52
    },
    {
      "text": "بين الدعامات الحجرية وأحواض الحديد المسبوك",
      "start": 84.52,
      "end": 87.58
    },
    {
      "text": "عكس تطور صناعة الحديد البريطانية وقتها",
      "start": 87.58,
      "end": 90.5
    },
    {
      "text": "وقدرتها على إنتاج قطع متطابقة تتحمل",
      "start": 90.5,
      "end": 94.26
    },
    {
      "text": "الأوزان الهائلة بمرور الزمن. استكمال بناء",
      "start": 94.26,
      "end": 97.58
    },
    {
      "text": "القنطرة دي جه في بداية القرن",
      "start": 97.58,
      "end": 99.4
    },
    {
      "text": "التاسع عشر، وتحديداً في عام 1805،",
      "start": 99.4,
      "end": 102.7
    },
    {
      "text": "لتصبح نموذج متفرد لكل مشاريع النقل",
      "start": 102.7,
      "end": 106.72
    },
    {
      "text": "المائي بعدها. الفترة دي شهدت طفرة",
      "start": 106.72,
      "end": 110.02
    },
    {
      "text": "حقيقية في تطبيقات الحديد الهيكلي وتطوير",
      "start": 110.22,
      "end": 113.1
    },
    {
      "text": "شبكات الملاحة الصناعية في أوروبا كلها.",
      "start": 113.1,
      "end": 116.4
    },
    {
      "text": "مع مرور العقود، واجهت المنشأة تحديات",
      "start": 116.4,
      "end": 119.46
    },
    {
      "text": "تخص ثبات الجوانب الحجرية والردم القديم.",
      "start": 119.46,
      "end": 121.48
    },
    {
      "text": "عمليات الترميم والإصلاح استلزمت أحياناً استخدام",
      "start": 121.74,
      "end": 126.52
    },
    {
      "text": "تقنيات حديثة مختلفة عن المواد الأصلية،",
      "start": 126.58,
      "end": 129.26000000000002
    },
    {
      "text": "مثل الصفائح المعدنية والخرسانة، عشان تفضل",
      "start": 129.26,
      "end": 133.34
    },
    {
      "text": "القناة محافظة على كفاءتها التشغيلية ومياهها",
      "start": 133.34,
      "end": 136.06
    },
    {
      "text": "جارية. في النهاية، فضلت قناة بونكتيسيلت",
      "start": 136.06,
      "end": 139.24
    },
    {
      "text": "شاهد حي على قدرة العقل البشري",
      "start": 140.3,
      "end": 142.64
    },
    {
      "text": "على تطويع الطبيعة الصعبة. الأسلوب الابتكاري",
      "start": 142.64,
      "end": 145.8
    },
    {
      "text": "اللي استخدمه تيلفورد في دمج الحديد",
      "start": 145.8,
      "end": 147.78
    },
    {
      "text": "والمجرى المائي ما وقفش تأثيره عند",
      "start": 147.78,
      "end": 150.1
    },
    {
      "text": "ويلز، ده اتخذته مشاريع هندسية كتيرة",
      "start": 150.1,
      "end": 153.04
    },
    {
      "text": "حول العالم مرجع أساسي لها.",
      "start": 153.14,
      "end": 155.16
    }
  ],
