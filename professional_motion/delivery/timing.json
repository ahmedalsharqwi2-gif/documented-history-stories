  "caption_groups": [
    {
      "text": "الهرم الأكبر اللي قدامك مش كان",
      "start": 0,
      "end": 2.64
    },
    {
      "text": "شكله كده طول الوقت. الحجر اللي",
      "start": 2.64,
      "end": 5.1
    },
    {
      "text": "بنشوفه النهارده كان مستخبي تحت كسوة",
      "start": 5.1,
      "end": 7.78
    },
    {
      "text": "أفتح وأنعم. وده يفتح سؤال أهم",
      "start": 7.78,
      "end": 11.04
    },
    {
      "text": "من حجمه: المواد دي وصلت للمكان",
      "start": 11.04,
      "end": 13.72
    },
    {
      "text": "واتجمعت إزاي؟ ده هرم الملك خوفو،",
      "start": 14.32,
      "end": 17.06
    },
    {
      "text": "واتعمل كمقبرة ليه. ومن عجائب الدنيا",
      "start": 18.94,
      "end": 19.86
    },
    {
      "text": "السبع القديمة، هو الوحيد اللي لسه",
      "start": 19.86,
      "end": 22.34
    },
    {
      "text": "باقي لحد النهارده. يعني إحنا مش",
      "start": 22.34,
      "end": 24.72
    },
    {
      "text": "قدام شكل مشهور وخلاص؛ إحنا قدام",
      "start": 24.72,
      "end": 27.3
    },
    {
      "text": "أثر جمع بين العمارة ووظيفة المقبرة",
      "start": 27.3,
      "end": 30.14
    },
    {
      "text": "الملكية. حسب وزارة السياحة والآثار، جسم",
      "start": 30.14,
      "end": 33.84
    },
    {
      "text": "الهرم اتبنى من حجر جيري محلي،",
      "start": 33.84,
      "end": 35.72
    },
    {
      "text": "لكن الكسوة الخارجية كانت من حجر",
      "start": 36.02,
      "end": 38.64
    },
    {
      "text": "جيري عالي الجودة. الفرق ده مهم:",
      "start": 38.64,
      "end": 41.62
    },
    {
      "text": "الحجر اللي بيكوّن الجسم مش بالضرورة",
      "start": 41.62,
      "end": 44.24
    },
    {
      "text": "هو نفس الحجر اللي كان بيحدد",
      "start": 44.24,
      "end": 45.78
    },
    {
      "text": "شكل السطح. حجر الكسوة اتجاب من",
      "start": 45.78,
      "end": 48.24
    },
    {
      "text": "طرة، جنوب المعادي، واتنقل بالسفن. قبل",
      "start": 48.24,
      "end": 51.48
    },
    {
      "text": "ما نفكر في رفع الحجر، فيه",
      "start": 51.48,
      "end": 53.02
    },
    {
      "text": "رحلة نقل لازم تحصل. تخيل ترتيب",
      "start": 53.22,
      "end": 55.92
    },
    {
      "text": "وصول المواد لمشروع بالحجم ده؛ البناء",
      "start": 55.92,
      "end": 58.66
    },
    {
      "text": "هنا مش شكل هندسي بس، دي",
      "start": 58.66,
      "end": 60.82
    },
    {
      "text": "كمان حكاية تنظيم ونقل. الهرم مش",
      "start": 60.82,
      "end": 64.28
    },
    {
      "text": "كتلة مصمتة من غير فراغات. المصدر",
      "start": 64.28,
      "end": 66.74
    },
    {
      "text": "الرسمي بيذكر تلات حجرات: واحدة محفورة",
      "start": 66.74,
      "end": 69.5
    },
    {
      "text": "في الصخر تحت الهرم، واتنين أعلى",
      "start": 69.5,
      "end": 71.62
    },
    {
      "text": "منها جوه البناء نفسه. المقطع التوضيحي",
      "start": 71.62,
      "end": 74.28
    },
    {
      "text": "بيقرّب الفكرة، مش بيعرض خريطة بمقاسات",
      "start": 74.76,
      "end": 77.48
    },
    {
      "text": "أصلية لكل ممر وحجرة. في الحجرة",
      "start": 77.48,
      "end": 80.42
    },
    {
      "text": "العلوية، غرفة الملك، لسه التابوت موجود.",
      "start": 80.42,
      "end": 83.08000000000001
    },
    {
      "text": "والوصول ليها بيكون عبر البهو الكبير،",
      "start": 83.16,
      "end": 85.84
    },
    {
      "text": "وهو ممر صاعد ضخم بتوصفه الوزارة",
      "start": 85.84,
      "end": 89.1
    },
    {
      "text": "كعمل مميز في الهندسة والعمارة القديمة.",
      "start": 89.1,
      "end": 90.58
    },
    {
      "text": "هنا التفاصيل اللي جوه مهمة زي",
      "start": 92.08,
      "end": 94.36
    },
    {
      "text": "الشكل الخارجي اللي كلنا عارفينه. الارتفاع",
      "start": 94.36,
      "end": 97.5
    },
    {
      "text": "الأصلي، حسب المصدر الرسمي، كان حوالي",
      "start": 97.5,
      "end": 100.52
    },
    {
      "text": "مية وستة وأربعين متر ونص. والهرم",
      "start": 101.26,
      "end": 103.0
    },
    {
      "text": "فضل أعلى بناء في العالم لآلاف",
      "start": 103.0,
      "end": 105.5
    },
    {
      "text": "السنين. الرقم مش مجرد معلومة نحفظها؛",
      "start": 105.5,
      "end": 108.39
    },
    {
      "text": "بص لحجم المشروع، وفكر في رحلة",
      "start": 108.68,
      "end": 111.3
    },
    {
      "text": "الحجر من المحجر لحد مكانه. بس",
      "start": 111.3,
      "end": 114.56
    },
    {
      "text": "ضخامة الأثر ما تديناش حق نخترع",
      "start": 114.56,
      "end": 116.52
    },
    {
      "text": "تفاصيل. الوزارة بتوضح إن طريقة البناء",
      "start": 116.96,
      "end": 120.34
    },
    {
      "text": "مش محسومة بكل تفاصيلها لحد النهارده.",
      "start": 120.34,
      "end": 123.18
    },
    {
      "text": "نعرف مواد، ونقل، وحجرات موجودة فعلًا؛",
      "start": 123.18,
      "end": 126.56
    },
    {
