  "caption_groups": [
    {
      "text": "في وسط إسبانيا، وفوق صخور الوادي،",
      "start": 0,
      "end": 3.02
    },
    {
      "text": "بيظهر أثر مش بيختفي من الذاكرة.",
      "start": 3.02,
      "end": 5.08
    },
    {
      "text": "دي قناطر سيغوفيا الرومانية اللي بتعتبر",
      "start": 6.16,
      "end": 9.2
    },
    {
      "text": "شاهد حي على هندسة زمان. البناء",
      "start": 9.2,
      "end": 12.46
    },
    {
      "text": "ده لسه واقف قدامنا بكل هيبة،",
      "start": 12.46,
      "end": 14.96
    },
    {
      "text": "وبيحكي قصة مدينة كاملة اتربطت بالميه",
      "start": 15.12,
      "end": 18.4
    },
    {
      "text": "اللي ماشية فوق السحاب. تاريخ القناطر",
      "start": 18.4,
      "end": 20.98
    },
    {
      "text": "دي بيرجع لقرابة العام خمسين من",
      "start": 21.46,
      "end": 23.9
    },
    {
      "text": "الحقبة المسيحية. الإمبراطورية الرومانية سابت وراها",
      "start": 23.9,
      "end": 27.54
    },
    {
      "text": "شواهد هندسية كتيرة، بس الصرح ده",
      "start": 27.54,
      "end": 30.84
    },
    {
      "text": "اتحفظ بشكل نادر ومذهل. إزاي قدر",
      "start": 30.84,
      "end": 34.96
    },
    {
      "text": "البناء ده يفضل ثابت كل القرون",
      "start": 34.96,
      "end": 37.1
    },
    {
      "text": "دي من غير ما يقع؟ ده",
      "start": 37.1,
      "end": 38.82
    },
    {
      "text": "اللي بتكشفه تفاصيل التصميم. لو بصيت",
      "start": 38.82,
      "end": 41.8
    },
    {
      "text": "على الهيكل، هتلاقي طبقتين من القناطر",
      "start": 41.8,
      "end": 44.04
    },
    {
      "text": "فوق بعض بانتظام دقيق. الطبقات دي",
      "start": 44.54,
      "end": 47.66
    },
    {
      "text": "مش شكل جمالي وبس، دي طريقة",
      "start": 47.66,
      "end": 49.82
    },
    {
      "text": "هندسية مدروسة عشان توزع الوزن الهائل.",
      "start": 49.82,
      "end": 53.02
    },
    {
      "text": "القناطر المزدوجة دي بتدي المبنى صلابة",
      "start": 53.68,
      "end": 55.78
    },
    {
      "text": "تخلي الرياح والعوامل الجوية ما يأثروش",
      "start": 55.78,
      "end": 57.72
    },
    {
      "text": "عليه بسهولة. المشروع الضخم ده بيوصل",
      "start": 58.36,
      "end": 61.6
    },
    {
      "text": "طوله الإجمالي إلى ثمانمائة وثلاثة عشر",
      "start": 61.6,
      "end": 62.72
    },
    {
      "text": "متراً. الهيكل بيتكون من أربعة قطاعات",
      "start": 64.96,
      "end": 67.08
    },
    {
      "text": "مستقيمة وممرين علويين بيشيلهم عدد ضخم",
      "start": 67.08,
      "end": 70.6
    },
    {
      "text": "من الأعمدة. والأعمدة دي هي اللي",
      "start": 70.6,
      "end": 73.2
    },
    {
      "text": "شايلة العبء كله وراسمة شكل الوادي",
      "start": 73.2,
      "end": 75.8
    },
    {
      "text": "بطريقة فريدة. في أدنى نقطة من",
      "start": 75.8,
      "end": 78.02
    },
    {
      "text": "الوادي، بيرتفع القنطر مسافة ثمانية وعشرين",
      "start": 78.02,
      "end": 80.18
    },
    {
      "text": "متراً ونصف المتر عن سطح الأرض.",
      "start": 81.44,
      "end": 83.01
    },
    {
      "text": "المائة وستة وعشرون عموداً أو أكتر",
      "start": 85.28,
      "end": 85.84
    },
    {
      "text": "بتتحمل الضغط الهائل ده بكل ثبات.",
      "start": 86.14,
      "end": 88.96
    },
    {
      "text": "الصرح ده بيوضح إزاي كانت الإدارة",
      "start": 89.2,
      "end": 91.96
    },
    {
      "text": "الرومانية بتوظف الموارد عشان توصل الميه",
      "start": 91.96,
      "end": 95.0
    },
    {
      "text": "للمرتفعات. المجرى المائي العلوي كان بيلعب",
      "start": 95.38,
      "end": 98.88
    },
    {
      "text": "دور حيوي في حياة السكان اليومية",
      "start": 98.88,
      "end": 101.2
    },
    {
      "text": "عبر نقل الميه من مسافات بعيدة.",
      "start": 101.2,
      "end": 103.41
    },
    {
      "text": "الميه دي ما كانتش مجرد رفاهية،",
      "start": 103.38,
      "end": 106.1
    },
    {
      "text": "دي كانت عصب الحياة اللي قامت",
      "start": 106.1,
      "end": 108.62
    },
    {
      "text": "عليه مجتمعات كاملة. جریان الميه جوه",
      "start": 108.62,
      "end": 112.16
    },
    {
      "text": "القناة اتقان تصميمه عشان يمنع أي",
      "start": 112.16,
      "end": 114.82
    },
    {
      "text": "تسريب أو ركود. مع مرور الزمن،",
      "start": 114.82,
      "end": 117.83
    },
    {
      "text": "خضع الأثر ده لقوانين حماية صارمة",
      "start": 117.83,
      "end": 120.55
    },
    {
      "text": "عشان يفضل محافظ على شكله الأصلي.",
      "start": 120.55,
      "end": 122.92999999999999
    },
    {
      "text": "الحكومة الإسبانية والجهات المعنية فرضت قواعد",
      "start": 123.37,
      "end": 126.67
    },
    {
      "text": "دقيقة لأي أعمال ترميم أو تنقيب.",
      "start": 127.21,
      "end": 129.51
    },
    {
      "text": "الإجراءات دي بتضمن إن أي تدخل",
      "start": 129.51,
      "end": 131.67
    },
    {
      "text": "هندسي ما يضرش بالقيمة التاريخية الفريدة",
      "start": 131.67,
      "end": 134.39
    },
    {
      "text": "للمكان. في النهاية، القناطر دي بقت",
      "start": 134.39,
      "end": 137.09
    },
    {
      "text": "الرمز الحقيقي لمدينة سيغوفيا واللي ما",
      "start": 137.1,
      "end": 139.69
    },
    {
      "text": "ينفعش تتفصل عنها أبداً. الصرح ده",
      "start": 139.69,
      "end": 142.05
    },
    {
      "text": "لسه بيجمع بين روعة الهندسة القديمة",
      "start": 142.05,
      "end": 143.91
    },
    {
      "text": "وقوة التحمل اللي تحدت الزمن. أثر",
      "start": 144.37,
      "end": 147.63
    },
    {
      "text": "بيثبت إن الإنجازات العظيمة ممكن تعيش",
      "start": 148.19,
      "end": 150.49
    },
    {
      "text": "آلاف السنين لتلهم الأجيال.",
      "start": 150.49,
      "end": 153.01
    }
  ],
