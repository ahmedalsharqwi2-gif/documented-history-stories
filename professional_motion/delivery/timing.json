  "scenes": [
    {
      "id": "scene_1",
      "label": "قناة بونكتيسيلت",
      "narration": "في شمال شرق مقاطعة ويلز، وتحديداً في أجواء الثورة الصناعية، ظهر إنجاز هندسي ضخم بيمتد لمسافة ثمانية عشر كيلومتراً. المشروع ده بيعكس تحدي كبير للبيئة الجغرافية الوعرة اللي اختاروها عشان تمر منها المية من غير أي كوابح تقليدية تعطل حركة النقل المائي.",
      "labels": [
        "إنجاز هندسي ضخم"
      ],
      "visual_mode": "hero",
      "evidence_excerpt_id": 8,
      "evidence_quote": "Indicators Pontcysyllte Aqueduct and Canal Situated in north-eastern Wales, the 18 kilometre long Pontcysyllte Aqueduct",
      "start": 0,
      "end": 20.52
    },
    {
      "id": "scene_2",
      "label": "تصميم توماس تيلفورد",
      "narration": "المهندس المدني الشهير توماس تيلفورد هو اللي وضع التصميم الأساسي للعمل ده. الرؤية الهندسية اعتمدت على إيجاد حلول جريئة وغير معتادة لتجاوز المرتفعات والوديان، وهو الأمر اللي تطلب تفكير مختلف تماماً عن الطرق القديمة اللي كانت بتعتمد على الإنشاءات الحجرية الضخمة لوحدها.",
      "labels": [
        "المهندس المدني الشهير توماس تيلفورد"
      ],
      "visual_mode": "section",
      "evidence_excerpt_id": 12,
      "evidence_quote": "The aqueduct is a pioneering masterpiece of engineering and monumental metal architecture, conceived by the",
      "start": 20.52,
      "end": 40.44
    },
    {
      "id": "scene_3",
      "label": "المعدن المسبوك",
      "narration": "السر الأساسي في نجاح التصميم ده كان استخدام المعدن المسبوك والحديد المزخرف في هيكل القناة. المادتين دول سمحوا بإنشاء قناطر بتتسم بالخفة والصلابة في نفس الوقت، وده أدى لشكل نهائي بيجمع بين الضخامة والرشاقة الهندسية الواضحة لكل عابر.",
      "labels": [
        "المعدن المسبوك والحديد المزخرف"
      ],
      "visual_mode": "material",
      "evidence_excerpt_id": 13,
      "evidence_quote": "celebrated civil engineer Thomas Telford. The use of both cast and wrought iron in the",
      "start": 40.44,
      "end": 57.02
    },
    {
      "id": "scene_4",
      "label": "بدون كوابح",
      "narration": "من أبرز الخصائص التشغيلية للقناة إنها اتبلت وبُنيت من غير استخدام أي كوابح نهائياً على طول مسارها. ده تطلب دقة بالسنتيمتر في توزيع المية ووزنها داخل المجرى المصنوع من الحديد، عشان يفضل التدفق مستمر ومنتظم من غير ما يشكل ضغط مدمر على الجوانب.",
      "labels": [
        "من غير استخدام أي كوابح"
      ],
      "visual_mode": "water",
      "evidence_excerpt_id": 11,
      "evidence_quote": "canal required substantial, bold civil engineering solutions, especially as it was built without using locks.",
      "start": 57.02,
      "end": 76.16
    },
    {
      "id": "scene_5",
      "label": "تجميع الأجزاء",
      "narration": "العمل اعتمد على تجميع أجزاء معدنية متكررة بدقة متناهية فوق دعامات حجرية مرتفعة ورقيقة. التناغم بين الدعامات الحجرية وأحواض الحديد المسبوك عكس تطور صناعة الحديد البريطانية وقتها وقدرتها على إنتاج قطع متطابقة تتحمل الأوزان الهائلة بمرور الزمن.",
      "labels": [
        "دعامات حجرية مرتفعة ورقيقة"
      ],
      "visual_mode": "assembly",
      "evidence_excerpt_id": 65,
      "evidence_quote": "Thomas Telford. It was constructed using metal arches supported by tall, slender masonry piers. The",
      "start": 76.16,
      "end": 96.62
    },
    {
      "id": "scene_6",
      "label": "اكتمال البناء",
      "narration": "استكمال بناء القنطرة دي جه في بداية القرن التاسع عشر، وتحديداً في عام 1805، لتصبح نموذج متفرد لكل مشاريع النقل المائي بعدها. الفترة دي شهدت طفرة حقيقية في تطبيقات الحديد الهيكلي وتطوير شبكات الملاحة الصناعية في أوروبا كلها.",
      "labels": [
        "بداية القرن التاسع عشر"
      ],
      "visual_mode": "hero",
      "evidence_excerpt_id": 20,
      "evidence_quote": "exploit du génie civil de la Révolution industrielle. Achevé au début du XIXème siècle, le",
      "start": 96.62,
      "end": 116.4
    },
    {
      "id": "scene_7",
      "label": "أعمال الصيانة",
      "narration": "مع مرور العقود، واجهت المنشأة تحديات تخص ثبات الجوانب الحجرية والردم القديم. عمليات الترميم والإصلاح استلزمت أحياناً استخدام تقنيات حديثة مختلفة عن المواد الأصلية، مثل الصفائح المعدنية والخرسانة، عشان تفضل القناة محافظة على كفاءتها التشغيلية ومياهها جارية.",
      "labels": [],
      "visual_mode": "section",
      "evidence_excerpt_id": 84,
      "evidence_quote": "initial backfills, both for structural resistance and waterproofing: concrete, steel pilings, geotextiles, etc. From the",
      "start": 116.4,
      "end": 137.14000000000001
    },
    {
      "id": "scene_8",
      "label": "التأثير العالمي",
      "narration": "في النهاية، فضلت قناة بونكتيسيلت شاهد حي على قدرة العقل البشري على تطويع الطبيعة الصعبة. الأسلوب الابتكاري اللي استخدمه تيلفورد في دمج الحديد والمجرى المائي ما وقفش تأثيره عند ويلز، ده اتخذته مشاريع هندسية كتيرة حول العالم مرجع أساسي لها.",
      "labels": [
        "قناة بونكتيسيلت"
      ],
      "visual_mode": "water",
      "evidence_excerpt_id": 17,
      "evidence_quote": "also recognized as an innovative ensemble that inspired many projects all over the world. Description",
      "start": 137.14000000000001,
      "end": 155.32
    }
