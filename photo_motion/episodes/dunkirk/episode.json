  "captions": [
    {
      "start": 0,
      "end": 2.94,
      "text": "في مايو سنة ألف وتسعمية وأربعين،"
    },
    {
      "start": 2.94,
      "end": 7.74,
      "text": "جيوش الحلفاء اتحاصرت على شاطئ دنكرك، في شمال فرنسا."
    },
    {
      "start": 7.74,
      "end": 9.58,
      "text": "الجيش الألماني كان بيتقدم،"
    },
    {
      "start": 9.58,
      "end": 11.4,
      "text": "والوقت كان بيخلص."
    },
    {
      "start": 11.4,
      "end": 17.32,
      "text": "الخطة كانت إنقاذ أكبر عدد ممكن من الجنود عبر القنال الإنجليزي."
    },
    {
      "start": 17.32,
      "end": 20.04,
      "text": "المشكلة إن المواني كانت مكشوفة،"
    },
    {
      "start": 20.04,
      "end": 23.78,
      "text": "والسفن الكبيرة ما قدرتش توصل للشاطئ بسهولة."
    },
    {
      "start": 23.78,
      "end": 26.32,
      "text": "هنا ظهرت فكرة القوارب الصغيرة."
    },
    {
      "start": 26.32,
      "end": 30.02,
      "text": "مراكب صيد ويخوت وقوارب مدنية،"
    },
    {
      "start": 30.02,
      "end": 31.9,
      "text": "اتحركت من بريطانيا،"
    },
    {
      "start": 31.9,
      "end": 35.2,
      "text": "وعدت القنال وسط الطيران والقصف،"
    },
    {
      "start": 35.2,
      "end": 37.96,
      "text": "عشان تنقل الجنود بعيد عن الحصار."
    },
    {
      "start": 37.96,
      "end": 42.16,
      "text": "على الشاطئ، الجنود كانوا بيتحركوا في طوابير طويلة،"
    },
    {
      "start": 42.16,
      "end": 47.92,
      "text": "والموشن على الخريطة بيوضح إزاي خطوط الإخلاء اتفتحت من أكتر من اتجاه."
    },
    {
      "start": 47.92,
      "end": 50.98,
      "text": "وكل رحلة صغيرة كانت بتفرق."
    },
    {
      "start": 50.98,
      "end": 52.84,
      "text": "خلال أيام قليلة،"
    },
    {
      "start": 52.84,
      "end": 56.74,
      "text": "اتنقل أكتر من تلتميت ألف جندي إلى بريطانيا."
    },
    {
      "start": 56.74,
      "end": 59.48,
      "text": "العملية ما كانتش انتصار عسكري،"
    },
    {
      "start": 59.48,
      "end": 62.3,
      "text": "لكنها أنقذت جيشًا كاملًا،"
    },
    {
      "start": 62.3,
      "end": 65.04,
      "text": "وخلت المقاومة تكمل الحرب."
    },
    {
      "start": 65.04,
      "end": 70.66,
      "text": "دنكرك بتفكرنا إن الخطة مش لازم تكون مثالية عشان تنجح."
    },
    {
      "start": 70.66,
      "end": 75.7,
      "text": "أحيانًا التعاون والسرعة واستغلال كل وسيلة متاحة،"
    },
    {
      "start": 75.7,
      "end": 77.6,
      "text": "بيغيروا نتيجة التاريخ."
    }
  ],
