# انسخ هذا الملف إلى .env.local، ثم ضع المفاتيح محليًا فقط.
# لا تضع أي مفتاح في Git أو في رسائل المحادثة.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# اختياري: يُستخدم بعد Gemini وقبل OpenRouter إذا أُضيف المفتاح.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free

TARGET_WORDS=850
ACCEPTABLE_MIN_WORDS=300
OPENROUTER_MIN_WORDS=300
MAX_NARRATION_WORDS=1050
LLM_INITIAL_BUDGET=9000
LLM_MAX_BUDGET=12000
LLM_MAX_CALLS=6
LLM_RETRIES=2
LLM_INVALID_RETRIES=2
LLM_DEADLINE_SECONDS=300
LLM_REQUEST_TIMEOUT=90
GEMINI_THINKING_BUDGET=0
